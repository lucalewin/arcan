{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT i.id, i.vault_id, i.server_revision, i.is_deleted, i.encrypted_payload, i.created_at, i.updated_at\n        FROM items i\n        JOIN UNNEST($1::uuid[], $2::bigint[]) AS req(id, rev) ON i.vault_id = req.id\n        WHERE i.server_revision > req.rev\n        ",
